    part us118 : UserStory {
        :>> id = "77259c46-0be0-4d06-84d0-4cd0e34cae26";
        :>> title = "The resync never seeds a ratchet over the project's own corpus";
        :>> createdAt = "2026-09-18"; :>> createdBy = "claudeFable5";
        :>> asA = "keel adopter migrating for the first time";
        :>> iWant = "the resync to leave parser-coverage-baseline.toml absent when my project has none, so the count I adopt is one I measured";
        :>> soThat = "my first migration is not reverted by a ratchet describing a corpus that is not mine";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "Verified against this tree before triage, not taken from the report: migrate.rs step_engine_resync returns early only under is_project_owned_contract && dst.exists(), so a missing destination is planned from the shipped default, and .engine/contracts/parser-coverage-baseline.toml at HEAD carries skipped = 7 with a comment asking the number be adopted deliberately. The report is correct. Routed to issue610, resolved by dcRatchetOverTheProjectsCorpusIsNeverSeeded under D0520 (held, process-change); code authored by the peer session, verified and landed here.";
    }
    #DerivedFrom dependency from us118 to st162;

    part us119 : UserStory {
        :>> id = "5ba960df-62f9-437d-9a3a-9e8fbdbc2217";
        :>> title = "A shipped charter resolves where the resync deploys it";
        :>> createdAt = "2026-09-18"; :>> createdBy = "claudeFable5";
        :>> asA = "keel adopter whose .engine came from a resync";
        :>> iWant = "the activation manifest's charteredBy to resolve against .engine/reference/decisions/ as well as .engine/decisions/";
        :>> soThat = "the shipped charter is not red in every adopting tree";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "Verified against this tree before triage: onboard.rs:72 at HEAD joins .engine/decisions only, and a migrate dry run plans reference/decisions/0226-*.sysml, so the shipped charter lands where the resolver never looks. The report is correct; the two integration tests that should have caught it exercise the authoring layout only. Routed to issue611, resolved by dcCharterResolvesInBothDecisionDirectories under D0520 (held); code authored by the peer session, verified and landed here.";
    }
    #DerivedFrom dependency from us119 to st163;

    part us120 : UserStory {
        :>> id = "bd7058c1-c228-4628-924c-165e7e5f4efe";
        :>> title = "source-reference holds me to my own citations, not the engine's";
        :>> createdAt = "2026-09-18"; :>> createdBy = "claudeFable5";
        :>> asA = "keel adopter with a Rust workspace";
        :>> iWant = "guard source-reference to set aside living docs the engine shipped and read only the citations my project authored";
        :>> soThat = "a shipped doc citing keel's own source cannot red my tree, and my own stale citations still can";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "Verified against this tree before triage: surface.rs:228 is the guard only scope test and living_doc_files (:485) walks all of .engine/; the two cited docs are shipped by the embedded engine. The reporter is right that the scaffold 0 scanned is comfort rather than a pass, and right that the guard is doing its job on this repository - it went red on all three citations when the GH#90 diff moved check_preconditions by 25 lines. Routed to issue612, resolved by dcSourceReferenceReadsTheAdoptersOwnClaims under D0520 (held): shipped docs are outside the population in a non-self-build root.";
    }
    #DerivedFrom dependency from us120 to st164;

    part us121 : UserStory {
        :>> id = "4429aa63-0d44-4e61-9fba-cca13dc8bc30";
        :>> title = "A record migrate tolerates at the door survives the run";
        :>> createdAt = "2026-09-18"; :>> createdBy = "claudeFable5";
        :>> asA = "keel adopter whose agent yields red turns";
        :>> iWant = "an engine-authored obligation migrate tolerated as separable to neither fail the post-apply gate nor be deleted by the rollback";
        :>> soThat = "the migration that cures the staleness is not blocked by a record the staleness produced, and the K7 audit trail survives";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "Verified against this tree before triage: is_tolerable_obligation tolerates the record at the door, project_gate runs gate guard all whole, and restore runs git clean -fdq -- .tracking (migrate.rs:997 at HEAD), which deletes an untracked file. Both halves of the report are correct and the second is the graver: the K7 record was destroyed and the guard then passed for that reason. Of the two suggested fixes the narrow one is taken (discount violations naming a tolerated record; exclude tolerated paths from clean); judging only regressions against a pre-apply baseline would mask every pre-existing red under a stale engine. Routed to issue613, resolved by dcToleratedRecordsSurviveTheRun under D0522 (held).";
    }
    #DerivedFrom dependency from us121 to st165;

    part us122 : UserStory {
        :>> id = "e5269b83-f46f-4996-8ca9-da69a08d21e7";
        :>> title = "A write refuses a verdict member my tree's schema lacks";
        :>> createdAt = "2026-09-18"; :>> createdBy = "claudeFable5";
        :>> asA = "keel adopter running a newer binary than my .engine";
        :>> iWant = "record gate-result to refuse, naming the member and keel migrate, rather than write VerdictKind::proposed into a tree whose schema does not declare it";
        :>> soThat = "record never leaves my tree invalid and reporting success";
        :>> implication = ImplicationKind::bug;
        :>> triageNote = "Verified against this tree before triage: write.rs:625 proposed_tier returns the binary constant with no read of the tree schema; element.sysml:27 gained proposed at 24dbcfb3 on 2026-09-10 and tag v0.4.1 is b171cd7f of 2026-09-06, so a release-scaffolded tree lacks the member. The report is correct. Writing pass instead would fabricate the tier D0312 B exists to prevent, so the fix is a refusal that names the vintage and keel migrate; with D0520/D0522 landed that migrate succeeds. Routed to issue614, resolved by dcAWriteRefusesTheMemberTheTreesSchemaLacks under D0521 (held).";
    }
