        :>> judgedAgainst = "f365cb7a21cf0147a06d4c3c6b70e94e8007eacb";
        :>> judgedAt = "2026-09-22";
        :>> judgedBy = "claudeFable5";
        :>> notes = "Round 1: nine reports, 2 ACCEPT / 7 OBJECT, 3 BLOCKER / 47 MAJOR / 33 MINOR; every flip set resolved in revision 2.";
    }
    part kRunnerDirectionPanelR2 : TestResult {
        :>> id = "a25ce58d-011c-41ab-8e99-c8626e4ced8d";
        :>> outcome = VerdictKind::pass;
        :>> judgedAgainst = "f365cb7a21cf0147a06d4c3c6b70e94e8007eacb";
        :>> judgedAt = "2026-09-22";
        :>> judgedBy = "claudeFable5";
        :>> notes = "Round 2: nine reports, 0 ACCEPT / 9 OBJECT, 0 / 36 / 35 after the tally correction; six revision-2 defects resolved in revision 3.";
    }
    part kRunnerDirectionPanelR3 : TestResult {
        :>> id = "025c66a1-38dc-4ed4-aa3b-049407e4815e";
        :>> outcome = VerdictKind::pass;
        :>> judgedAgainst = "f365cb7a21cf0147a06d4c3c6b70e94e8007eacb";
        :>> judgedAt = "2026-09-22";
        :>> judgedBy = "claudeFable5";
        :>> notes = "Round 3: nine reports, 3 ACCEPT / 6 OBJECT, 0 / 28 / 27; convergence not reached; residue handed to the human as D0543-D0549; author-fixable items landed in revision 4.";
    }
