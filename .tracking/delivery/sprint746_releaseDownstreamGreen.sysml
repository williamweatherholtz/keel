// ProjectDeliveryS746 — Sprint 746: v0.5.0 lands downstream green - the release the adopters asked for (GH#68, GH#86-90) is cut, published, verified from its own asset, and the three retro-745 findings that would meet the next adopter are closed: the guard set runs over an adopter-shaped tree in the suite (issue615), the SchemaLacksMember refusal is a census row and a ledger fact (issue616), and keel onboard's unresolved-charter advice fits a first-time adopter (issue617); the release cut itself surfaced a fourth, two guard fixtures pinned at the literal 0.4.1 (issue619). The human's direction: 'Proceed to release and fix downstream' (2026-09-18).. EXECUTE. 5 pts.
package ProjectDeliveryS746 {
    private import EngineElement::*;
    private import EngineWork::*;
    private import EngineVerification::*;
    private import EngineRelationships::*;

    #CharteredBy dependency from releaseDownstreamGreenStory to d0519;

    part releaseDownstreamGreenStory : Story {
        :>> id = "6a180e3d-65bf-403b-aaa9-98903d381dc2";
        :>> title = "Sprint 746: v0.5.0 lands downstream green - the release the adopters asked for (GH#68, GH#86-90) is cut, published, verified from its own asset, and the three retro-745 findings that would meet the next adopter are closed: the guard set runs over an adopter-shaped tree in the suite (issue615), the SchemaLacksMember refusal is a census row and a ledger fact (issue616), and keel onboard's unresolved-charter advice fits a first-time adopter (issue617); the release cut itself surfaced a fourth, two guard fixtures pinned at the literal 0.4.1 (issue619). The human's direction: 'Proceed to release and fix downstream' (2026-09-18). (5 pts)";
        :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> kind = WorkKind::code; :>> priority = WorkPriority::p0; :>> owner = "claudeFable5"; :>> estimatedPoints = 5;
    }

    action def DeliveryRunS746 {
        action storyReleaseDownstreamGreen;
        verification storyReleaseDownstreamGreenDoD : Test { :>> id = "e145c270-44a1-4e71-b6bb-45aed2d78f8e"; :>> method = VerificationMethod::test; :>> procedureText = "DELIVERED BACKLOG ITEMS: dcReleaseGuardFixturesPinTheBinaryVersion, dcAFreshAdopterTreeIsGreenUnderEveryGuard, dcSchemaLacksMemberRefusalIsLedgered, dcUnresolvedCharterAdviceFitsAFirstTimeAdopter, dcVerbFoldsTravelWithMigrate (added mid-sprint: the downloaded 0.5.0 rolled back on the adopter tree - issue620 - so the release that lands downstream is 0.5.1, cut in this sprint). DONE MEANS: each task's DoD holds with its own tests (the D0388 pairs named in the DoDs); tag v0.5.0 is pushed at a commit CI verified, the release run attached three assets, their .sha256 files and SHA256SUMS, the downloaded windows asset verifies against SHA256SUMS and reports 0.5.0 at the tagged commit, keel-wrapper.toml carries the ['0.5.0'] entries copied from the published SHA256SUMS and release050's commit field names the tagged sha; keel migrate run by the DOWNLOADED 0.5.1 binary over a tree keel init 0.4.1 scaffolded (a Cargo.toml and one Rust member, not the self-build) ends green under its own post-apply gate with its CLAUDE.md naming keel show orient; 0.5.1 is tagged, published and wrapper-pinned the same way as 0.5.0; GH#86-90 carry a comment naming the release that lands; the ladder is green and CI green at each landing commit."; }
    }

    verification releaseDownstreamGreenRefineGate : Test { :>> id = "8f4789f9-97fc-4a60-83f0-254e7c746de5"; :>> title = "Sprint 746 refine gate (DoR)"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "DoR: four tasks sized together at 5 points - the adopter-shaped suite test is a module (a fixture, the guard run, the pair), the census/ledger rows and the onboard advice are one-function changes with tests, the fixture pin is a two-line change already verified; the release steps are the release skill's procedure, not new code. Scope is the four DoDs plus the release skill's steps 2-5. No blocking dependency: the release cut is committed locally (72eebf0a) and lands with the fixture fix."; }
    part releaseDownstreamGreenRefineGateR1 : TestResult { :>> id = "c100edbe-c923-4c46-a038-7f8261dba4cc"; :>> outcome = VerdictKind::proposed; :>> judgedAgainst = "4a0abc85"; :>> judgedAt = "2026-09-18"; :>> judgedBy = "claudeFable5"; :>> notes = "DoR read against the story: four tasks named with DoDs carrying D0388 pairs; 5 points; #CharteredBy d0519 (accepted, marked); no blocking dependency - the release cut 72eebf0a and the fixture fix 4a0abc85 landed, CI success at 4a0abc85, tag v0.5.0 pushed at it."; }
    verification releaseDownstreamGreenStandupGate : Test { :>> id = "9db30b8c-8ef1-4c5a-84b8-084da8b4973e"; :>> title = "Sprint 746 standup gate"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Owner claudeFable5. Blocker: none. Risk: the tag must point at a commit CI has verified, so the fixture fix lands and CI concludes before the tag is pushed; the wrapper entries can only be copied after the release run publishes SHA256SUMS, so they and the release050 commit field land one commit after the tag (issue311). A second risk: the adopter-shaped test deploys the embedded engine, so it is keyed on the engine's content and re-runs on every .engine change - the cost is the suite's, stated in the DoD."; }
    part releaseDownstreamGreenStandupGateR1 : TestResult { :>> id = "dba6c1ea-2f2c-4080-93d8-b0b4e8c0eff3"; :>> outcome = VerdictKind::proposed; :>> judgedAgainst = "4a0abc85"; :>> judgedAt = "2026-09-18"; :>> judgedBy = "claudeFable5"; :>> notes = "Standup: owner claudeFable5; release run 35417343896 concluded success at 4a0abc85; the three resolvers are coded and their tests pass locally (init_smoke 3 passed, schema_member_refusal_is_ledgered 3 passed, keel-model onboard:: 4 passed); the ladder is being climbed; the wrapper entries wait on the published SHA256SUMS (issue311)."; }
    verification releaseDownstreamGreenImplementGate : Test { :>> id = "5497e63b-99a6-4b0a-a231-2648ed4d95b2"; :>> title = "Sprint 746 implement gate"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::test; :>> procedureText = "The implement gate is the change itself under the ladder: keel verify . --probe-from pair746.txt (validate, check-engine, guard, clippy, the pair, suite --touched), stopping at the first red; plus the release skill's verification of the published asset (sha256sum -c against SHA256SUMS, the downloaded binary's version and build commit)."; }
    verification releaseDownstreamGreenReviewGate : Test { :>> id = "a66cf76e-7fba-4d86-8b0e-16e3ee48cc8e"; :>> title = "Sprint 746 review gate — three passes per D0172"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Verifier receipt read against the four DoDs: every named test present and passing; the release assets and SHA256SUMS verified from the download, not from the workflow log; guard wrapper-pin-checksummed green once the entries land; three passes per D0172 (substance, ceremony, doc-sync: the CHANGELOG entry names what shipped, the release skill's steps were followed in order)."; }
    verification releaseDownstreamGreenCloseOutGate : Test { :>> id = "3298d61d-5b01-4975-a4c5-fd9926c362b8"; :>> title = "Sprint 746 closeOut gate (autonomous, D0049)"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::inspect; :>> procedureText = "Landed by keel land with the touched set green and CI green at each landing commit; issue615-617 and issue619 resolve by their #Resolves edges; the tag is published and its assets verified; GH#86-90 are answered on GitHub with the release named."; }
    verification releaseDownstreamGreenRetroGate : Test { :>> id = "1f06fa9d-8e75-407f-be00-5b59f4b6058d"; :>> title = "Sprint 746 retro gate (autonomous, D0049)"; :>> createdAt = "2026-09-19"; :>> createdBy = "claudeFable5"; :>> method = VerificationMethod::analyze; :>> procedureText = "Written at closeOut, after the verifier's receipt and before the recorder; avoidable issues scanned (issue011), each finding a tracked item or the reason it is not. (1) Found at the sprint's opening, landing the release cut: keel land refused the push because two wrapper-pin guard fixtures pinned the literal 0.4.1 and were refused under engine-version skew by the 0.5.0 binary before the guard ran - a fixture that encodes the current release is green by coincidence and red on the next cut. Tracked: issue619 (Low), resolved by dcReleaseGuardFixturesPinTheBinaryVersion (the fixture reads env!(CARGO_PKG_VERSION); delivered in the same commit that adds it). Further findings are appended at closeOut."; }
}
