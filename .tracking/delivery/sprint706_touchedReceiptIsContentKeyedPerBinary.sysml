    part touchedReceiptIsContentKeyedPerBinaryReviewGateR1 : TestResult { :>> id = "5adda1ca-9d54-416f-b36f-c6376fa9667a"; :>> outcome = VerdictKind::proposed; :>> judgedAgainst = "8b731e6"; :>> judgedAt = "2026-09-14"; :>> judgedBy = "claudeFable5"; }
