    part touchedReceiptIsContentKeyedPerBinaryRetroGateR1 : TestResult { :>> id = "25c4914f-5d45-48be-a196-56de9237a965"; :>> outcome = VerdictKind::proposed; :>> judgedAgainst = "8b731e6"; :>> judgedAt = "2026-09-14"; :>> judgedBy = "claudeFable5"; }
